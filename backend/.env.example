# Server
PORT=5000

# MongoDB (leave empty for in-memory demo mode)
MONGODB_URI=

# Demo Mode (true = no LLM API key needed)
DEMO_MODE=true

# LLM Configuration (only needed when DEMO_MODE=false)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# CORS
CORS_ORIGIN=http://localhost:5173

# Risk Weights (JSON) — demonstration rules, not universal standards
RISK_WEIGHTS={"AMOUNT_ANOMALY":20,"NEW_DEVICE":20,"NEW_LOCATION":15,"UNUSUAL_TIME":10,"PREVIOUS_ALERT":20,"SHARED_DEVICE":15}
